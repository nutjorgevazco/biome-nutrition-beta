{
  "name": "nutriplanpro",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.biomenutrition.app",
    "productName": "BiomeNutrition",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json",
      "!node_modules",
      "!src",
      "!public",
      "!asar_contents",
      "!*.mjs",
      "!*.cjs",
      "!*.txt",
      "!tailwind.config.js",
      "!vite.config.js",
      "!postcss.config.cjs",
      "!.oxlintrc.json",
      "!.gitignore",
      "!README.md"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0",
    "xlsx": "^0.18.5"
  }
}
